/* Foglio di stile centralizzato. Le variabili $nome sono sostituite dalla palette del tema. */
/* Griglia di spaziatura: multipli di 4px. */

QWidget {
    background-color: $bg;
    color: $text;
    font-size: 10pt;
}

QMainWindow, QDialog {
    background-color: $bg;
}

QMenuBar {
    background-color: $surface;
    border-bottom: 1px solid $border;
    padding: 4px 8px;
}
QMenuBar::item {
    background: transparent;
    padding: 4px 12px;
    border-radius: 4px;
}
QMenuBar::item:selected {
    background-color: $surface_alt;
}
QMenu {
    background-color: $surface;
    border: 1px solid $border;
    padding: 4px;
}
QMenu::item {
    padding: 8px 24px 8px 16px;
    border-radius: 4px;
}
QMenu::item:selected {
    background-color: $accent;
    color: $on_accent;
}
QMenu::separator {
    height: 1px;
    background: $border;
    margin: 4px 8px;
}

QFrame#Card {
    background-color: $surface;
    border: 1px solid $border;
    border-radius: 8px;
}

QLabel {
    background: transparent;
}
QLabel#Title {
    font-size: 16pt;
    font-weight: 600;
}
QLabel#SectionLabel {
    color: $text_muted;
    font-size: 9pt;
    font-weight: 600;
}
QLabel#Muted {
    color: $text_muted;
}

QLineEdit {
    background-color: $input_bg;
    border: 1px solid $border;
    border-radius: 6px;
    padding: 8px 12px;
    selection-background-color: $accent;
    selection-color: $on_accent;
}
QLineEdit:focus {
    border: 2px solid $accent;
    padding: 7px 11px;
}
QLineEdit#QuestionInput {
    font-size: 12pt;
    padding: 12px 16px;
}
QLineEdit#QuestionInput:focus {
    padding: 11px 15px;
}
QLineEdit:read-only {
    color: $text_muted;
}

QPushButton {
    background-color: $surface_alt;
    border: 1px solid $border;
    border-radius: 6px;
    padding: 8px 16px;
    min-height: 20px;
}
QPushButton:hover {
    background-color: $hover;
}
QPushButton:pressed {
    background-color: $border;
}
QPushButton:focus {
    border: 2px solid $accent;
    padding: 7px 15px;
}
QPushButton:disabled {
    color: $text_disabled;
    background-color: $surface;
}
QPushButton#Primary {
    background-color: $accent;
    border: 1px solid $accent;
    color: $on_accent;
    font-weight: 600;
}
QPushButton#Primary:hover {
    background-color: $accent_hover;
    border-color: $accent_hover;
}
QPushButton#Primary:disabled {
    background-color: $surface_alt;
    border-color: $border;
    color: $text_disabled;
}

QTreeWidget, QTextBrowser {
    background-color: $surface;
    border: 1px solid $border;
    border-radius: 8px;
    padding: 4px;
}
QTreeWidget::item {
    padding: 8px 4px;
}
QTreeWidget::item:hover {
    background-color: $surface_alt;
}
QTreeWidget::item:selected {
    background-color: $accent;
    color: $on_accent;
}
QHeaderView::section {
    background-color: $surface;
    color: $text_muted;
    border: none;
    border-bottom: 1px solid $border;
    padding: 8px;
    font-weight: 600;
}

QSplitter::handle {
    background-color: transparent;
    width: 8px;
}

QProgressBar {
    background-color: $surface_alt;
    border: none;
    border-radius: 4px;
    max-height: 8px;
    text-align: center;
    color: transparent;
}
QProgressBar::chunk {
    background-color: $accent;
    border-radius: 4px;
}

QStatusBar {
    background-color: $surface;
    border-top: 1px solid $border;
    color: $text_muted;
}
QStatusBar QLabel {
    padding: 0 8px;
}

QCheckBox {
    spacing: 8px;
    background: transparent;
}

QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 4px 2px;
}
QScrollBar::handle:vertical {
    background: $border;
    border-radius: 4px;
    min-height: 32px;
}
QScrollBar::handle:vertical:hover {
    background: $text_muted;
}
QScrollBar:horizontal {
    background: transparent;
    height: 12px;
    margin: 2px 4px;
}
QScrollBar::handle:horizontal {
    background: $border;
    border-radius: 4px;
    min-width: 32px;
}
QScrollBar::add-line, QScrollBar::sub-line {
    width: 0;
    height: 0;
}
QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

QToolTip {
    background-color: $surface_alt;
    color: $text;
    border: 1px solid $border;
    padding: 4px 8px;
}
